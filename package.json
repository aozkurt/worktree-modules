{
  "name": "worktree-modules",
  "version": "0.1.0",
  "description": "Share node_modules across git worktrees on Windows, safely: per-package junctions instead of copies, workspace-aware links, and removal that never deletes the shared folder.",
  "keywords": [
    "git",
    "worktree",
    "git-worktree",
    "worktrees",
    "node_modules",
    "junction",
    "symlink",
    "windows",
    "monorepo",
    "workspaces",
    "npm",
    "pnpm",
    "capacitor",
    "cli"
  ],
  "homepage": "https://github.com/aozkurt/worktree-modules#readme",
  "bugs": "https://github.com/aozkurt/worktree-modules/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aozkurt/worktree-modules.git"
  },
  "license": "MIT",
  "author": "Andaç Özkurt",
  "type": "module",
  "bin": {
    "worktree-modules": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
